generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  student
  faculty
  admin
}

enum UserStatus {
  pending
  active
  deactivated
}

enum AuthTokenType {
  email_verification
  password_reset
}

model User {
  id                  Int        @id @default(autoincrement())
  name                String     @db.VarChar(120)
  email               String     @unique @db.VarChar(160)
  passwordHash        String     @map("password_hash")
  role                Role
  avatar              String?    @db.VarChar(40)
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  tokenVersion        Int        @default(0) @map("token_version")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  studentProfile   StudentProfile?
  facultyProfile   FacultyProfile?
  authTokens       AuthToken[]
  uploadedProjects Project[]

  @@map("users")
}

model StudentProfile {
  userId            Int      @id @map("user_id")
  studentId         String?  @unique @map("student_id") @db.VarChar(20)
  department        String?  @db.VarChar(100)
  bio               String?
  skills            String[]
  interests         String[]
  technologies      String[]
  domains           String[]
  lookingForPartner Boolean  @default(false) @map("looking_for_partner")
  showEmail         Boolean  @default(false) @map("show_email")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model FacultyProfile {
  userId        Int      @id @map("user_id")
  department    String?  @db.VarChar(100)
  designation   String?  @db.VarChar(100)
  researchAreas String[] @map("research_areas")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("faculty_profiles")
}

model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(300)
  abstract     String?
  domain       String?  @db.VarChar(100)
  year         Int?
  supervisor   String?  @db.VarChar(120)
  teamMembers  String[] @map("team_members")
  pdfPath      String?  @map("pdf_path")
  pdfName      String?  @map("pdf_name") @db.VarChar(255)
  pdfSize      Int?     @map("pdf_size")
  uploadedById Int?     @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedBy User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  text       ProjectText?
  embeddings ProjectEmbedding[]

  @@index([domain])
  @@map("projects")
}

model ProjectText {
  projectId   Int      @id @map("project_id")
  rawText     String?  @map("raw_text")
  cleanedText String?  @map("cleaned_text")
  pageCount   Int      @map("page_count")
  wordCount   Int      @map("word_count")
  extractedAt DateTime @default(now()) @map("extracted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_text")
}

model ProjectEmbedding {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  chunkText String   @map("chunk_text")
  embedding Float[]
  modelName String   @map("model_name") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_embeddings")
}
